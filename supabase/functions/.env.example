# delete-account 함수용 Secrets 예시 — 실제 값은 이 파일이 아니라 Supabase에 넣는다.
#   supabase secrets set --env-file supabase/functions/.env
# (.env는 git에 올라가지 않는다. 이 예시 파일을 복사해서 채운 뒤 위 명령으로 등록)

APPLE_TEAM_ID=YOUR_TEAM_ID
APPLE_KEY_ID=YOUR_KEY_ID
APPLE_CLIENT_ID=com.yourname.subhelp
# .p8 파일 내용. 한 줄로 넣을 때는 줄바꿈을 \n으로 적는다
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_CONTENT\n-----END PRIVATE KEY-----"
